/* ============================================================
 *  LAYOUT  —  Fluent Dark
 * ============================================================ */

QFrame#headerCard,
QFrame#previewCard,
QFrame#analyticsCard,
QFrame#metricCard,
QFrame#emptyStateCard {
    background-color: #22262E;
    border: 1px solid #3A3F4B;
    border-radius: 12px;
}

QFrame#headerCard {
    border-top: 3px solid #4FA3E0;
    background-color: #22262E;
}

QFrame#analyticsCard {
    background-color: transparent;
    border: none;
    border-radius: 0px;
}

QFrame#metricCard {
    min-height: 92px;
    background-color: #262B35;
}

QFrame#videoPlayerCard {
    background-color: #22262E;
    border: 1px solid #3A3F4B;
    border-radius: 12px;
}

QFrame#videoControlsBar {
    background-color: #2A2F3A;
    border: 1px solid #3A3F4B;
    border-radius: 10px;
    padding: 8px;
}

QFrame#courtControlsBar {
    background-color: transparent;
    border: none;
    padding: 0px;
}

QWidget#timelineBar {
    background: transparent;
    border: none;
    border-top: 1px solid #313744;
    padding: 0px;
}

QFrame#videoTimelineCard {
    background: transparent;
    border: none;
    padding: 0px;
}
