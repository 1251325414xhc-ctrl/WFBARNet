/* ============================================================
 *  TABS  —  Fluent Dark
 * ============================================================ */

QTabWidget#mainTabs::pane {
    border: 1px solid #3A3F4B;
    border-radius: 12px;
    top: -1px;
    background-color: #22262E;
}

QTabWidget#mainTabs::tab-bar {
    left: 0px;
}

QTabBar::tab {
    background: #2A2F3A;
    color: #8A95A8;
    padding: 9px 16px;
    margin-right: 6px;
    border-radius: 10px;
    border: 1px solid #3A3F4B;
}

QTabBar::tab:selected {
    background: #22262E;
    color: #4FA3E0;
    font-weight: 600;
    border-bottom: 2px solid #4FA3E0;
}

QTabBar::tab:hover:!selected {
    background: #313744;
    color: #E8EDF5;
}
