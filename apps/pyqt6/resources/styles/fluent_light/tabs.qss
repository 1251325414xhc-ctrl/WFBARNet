/* ============================================================
 *  TABS  —  QTabWidget / QTabBar
 * ============================================================ */

QTabWidget#mainTabs::pane {
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    top: -1px;
    background-color: #FFFFFF;
}

QTabWidget#mainTabs::tab-bar {
    left: 0px;
}

QTabBar::tab {
    background: #F8FAFC;
    color: #64748B;
    padding: 9px 16px;
    margin-right: 6px;
    border-radius: 10px;
    border: 1px solid #E2E8F0;
}

QTabBar::tab:selected {
    background: #FFFFFF;
    color: #0F6CBD;
    font-weight: 600;
    border-bottom: 2px solid #0F6CBD;
}

QTabBar::tab:hover:!selected {
    background: #F1F5F9;
    color: #0F172A;
}
