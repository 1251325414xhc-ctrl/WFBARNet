    color: #17211D;
    font-family: "Segoe UI", "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
    font-size: 14px;
}

QWidget {
    color: #17211D;
    font-family: "Segoe UI", "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
    font-size: 14px;
}

#appRoot {
    background-color: #EEF1F2;
}

QToolTip {
    color: #FFFFFF;
    background-color: #262B33;
    border: none;
    padding: 6px 8px;
}
