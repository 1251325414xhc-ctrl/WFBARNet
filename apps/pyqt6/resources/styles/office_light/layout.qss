QFrame#headerCard {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E3E7EA;
    border-radius: 0px;
    min-height: 64px;
}

QFrame#modeNavigation {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #DDE2E6;
}

QFrame#workspaceBand {
    background-color: #EEF1F2;
    border: none;
    padding-top: 4px;
}

QFrame#previewCard,
QFrame#analyticsCard {
    background-color: #FFFFFF;
    border: 1px solid #D8DDE2;
    border-radius: 6px;
}

QFrame#analyticsCard {
    margin-left: 6px;
}

QFrame#metricsStrip,
QFrame#runtimeDiagnostics {
    background-color: #FFFFFF;
    border: none;
    border-radius: 0px;
}

QFrame#emptyStateCard {
    background-color: #FFFFFF;
    border: 1px solid #DDE2E6;
    border-radius: 6px;
}

QFrame#metricsStrip {
    min-height: 136px;
    max-height: 148px;
}

QFrame#runtimeDiagnostics {
    min-height: 88px;
    max-height: 104px;
}

QFrame#metricCell {
    background: transparent;
    border: none;
}

QFrame#metricSeparator {
    background-color: #E3E7EA;
    border: none;
    max-width: 1px;
    margin-top: 12px;
    margin-bottom: 12px;
}

QFrame#metricHorizontalSeparator {
    background-color: #E3E7EA;
    border: none;
    max-height: 1px;
    margin-left: 12px;
    margin-right: 12px;
}

QFrame#trainingNote {
    min-height: 76px;
    max-height: 104px;
    background-color: #F0F8F4;
    border: 1px solid #B8D9C7;
    border-radius: 5px;
}

QFrame#trainingNote[state="warning"] {
    background-color: #FFF8E8;
    border-color: #E5C46A;
}

QFrame#trainingNote[state="success"] {
    background-color: #F0F8F4;
    border-color: #B8D9C7;
}

QFrame#videoPlayerCard {
    background-color: #07100E;
    border: none;
    border-radius: 0px;
}

QFrame#videoControlsBar {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E3E7EA;
    border-radius: 0px;
}

QWidget#timelineBar,
QFrame#videoTimelineCard {
    background-color: #FFFFFF;
    border: none;
    border-top: 1px solid #E3E7EA;
    border-radius: 0px;
}

QSplitter#bodySplitter::handle {
    background: transparent;
    margin: 0px 2px;
}

QSplitter#bodySplitter::handle:hover,
QSplitter#bodySplitter::handle:pressed {
    background: #A6D7BC;
}
