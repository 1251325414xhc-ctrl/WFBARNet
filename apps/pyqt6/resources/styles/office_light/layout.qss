/* ============================================================
 *  LAYOUT  —  卡片、容器框架
 * ============================================================ */

/* --- 通用卡片 --- */
QFrame#headerCard,
QFrame#previewCard,
QFrame#analyticsCard,
QFrame#metricCard,
QFrame#emptyStateCard {
    background-color: #FFFFFF;
    border: 1px solid #D8DED8;
    border-radius: 12px;
}

/* previewCard 底部与 videoPlayerCard 无缝衔接 */
/* headerCard 顶部品牌色强调线 */
QFrame#headerCard {
    background-color: #F8F8F8;
    border-top: 3px solid #217346;
}

QFrame#analyticsCard {
    background-color: transparent;
    border: none;
    border-radius: 0px;
}

QFrame#metricCard {
    min-height: 92px;
    background-color: #F8FBF8;
}

/* --- 视频播放器容器 --- */
QFrame#videoPlayerCard {
    background-color: #FFFFFF;
    border: 1px solid #D8DED8;
    border-radius: 12px;
}

QFrame#videoControlsBar {
    background-color: #F7F7F7;
    border: 1px solid #D8DED8;
    border-radius: 10px;
    padding: 8px;
}

QFrame#courtControlsBar {
    background-color: transparent;
    border: none;
    padding: 0px;
}

QWidget#timelineBar {
    background: transparent;
    border: none;
    padding: 0px;
}

QFrame#videoTimelineCard {
    background: transparent;
    border: none;
    padding: 0px;
}
