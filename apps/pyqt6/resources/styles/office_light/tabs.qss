/* ============================================================
 *  TABS  —  QTabWidget / QTabBar
 * ============================================================ */

QTabWidget#mainTabs::pane {
    border: 1px solid #D8DED8;
    border-radius: 12px;
    top: -1px;
    background-color: #FFFFFF;
}

QTabWidget#mainTabs::tab-bar {
    left: 0px;
}

QTabBar::tab {
    background: #F3F3F3;
    color: #323130;
    padding: 9px 16px;
    margin-right: 6px;
    border-radius: 10px;
    border: 1px solid #D8DED8;
}

QTabBar::tab:selected {
    background: #FFFFFF;
    color: #217346;
    font-weight: 600;
    border-bottom: 2px solid #217346;
}

QTabBar::tab:hover:!selected {
    background: #F8F8F8;
    color: #1F1F1F;
}
