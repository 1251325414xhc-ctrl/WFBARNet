/* ============================================================
 *  TABLE  —  QTableWidget / QHeaderView
 * ============================================================ */

QTableWidget#actionTable {
    background-color: #FFFFFF;
    border: 1px solid #D8DED8;
    border-radius: 12px;
    gridline-color: #EEF2EE;
    alternate-background-color: #F8F8F8;
    selection-background-color: #EAF4EA;
    selection-color: #217346;
}

QTableWidget#actionTable::item {
    padding: 8px 10px;
}

QTableWidget#actionTable::item:selected {
    background-color: #EAF4EA;
    color: #217346;
    font-weight: 500;
}

QHeaderView::section {
    background-color: #F3F3F3;
    color: #323130;
    padding: 10px 8px;
    border: none;
    border-right: 1px solid #D8DED8;
    border-bottom: 1px solid #D8DED8;
    font-weight: 600;
}
