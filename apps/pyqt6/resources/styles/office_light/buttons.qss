/* ============================================================
 *  BUTTONS  —  QPushButton 全部变体
 * ============================================================ */

/* --- 默认按钮 --- */
QPushButton {
    min-height: 34px;
    border-radius: 9px;
    padding: 5px 14px;
    font-size: 13px;
    font-weight: 600;
    border: 1px solid #C9D6C9;
    background-color: #FFFFFF;
    color: #217346;
}

QPushButton:hover    { background-color: #EAF4EA; border-color: #8BBF9F; }
QPushButton:pressed  { background-color: #DDEEDD; border-color: #217346; }
QPushButton:disabled { background-color: #F0F0F0; color: #A19F9D; border-color: #D8DED8; }

/* --- 上传按钮（白底） --- */
QPushButton#btnUpload {
    background-color: #FFFFFF;
    color: #217346;
}

/* --- 小尺寸按钮组（header 区域） --- */
QPushButton#btnAnalyze,
QPushButton#btnReset,
QPushButton#btnSelectVideo,
QPushButton#btnForceStop,
QPushButton#btnFullscreen,
QPushButton#btnPreviewMode,
QPushButton#btnCameraMode,
QPushButton#btnBatchMode,
QPushButton#btnRefreshCameras,
QPushButton#btnHawkeyeChallenge {
    min-height: 20px;
    padding-top: 4px;
    padding-bottom: 4px;
}

QPushButton#btnPreviewMode,
QPushButton#btnCameraMode,
QPushButton#btnBatchMode {
    min-width: 88px;
    color: #323130;
    background-color: #F3F3F3;
    border-color: #D8DED8;
    border-bottom: none;
    border-radius: 10px;
    padding: 8px 16px;
    font-weight: 500;
}

QPushButton#btnPreviewMode:checked,
QPushButton#btnCameraMode:checked,
QPushButton#btnBatchMode:checked {
    color: #217346;
    background-color: #FFFFFF;
    border-color: #D8DED8;
    border-top: 2px solid #217346;
    font-weight: 600;
}

QPushButton#btnPreviewMode:hover:!checked,
QPushButton#btnCameraMode:hover:!checked,
QPushButton#btnBatchMode:hover:!checked {
    color: #1F1F1F;
    background-color: #F8F8F8;
}

QPushButton#btnRefreshCameras {
    min-width: 72px;
    color: #217346;
    background-color: #FFFFFF;
}

/* --- 开始分析（主色调） --- */
QPushButton#btnAnalyze {
    min-width: 68px;
    background-color: #217346;
    color: #FFFFFF;
    border-color: #217346;
}

QPushButton#btnAnalyze:hover    { background-color: #1B5E20; border-color: #1B5E20; }
QPushButton#btnAnalyze:pressed  { background-color: #144A17; border-color: #144A17; }
QPushButton#btnAnalyze:disabled { background-color: #E8EEE8; color: #A19F9D; border-color: #D8DED8; }

/* --- 重置（危险色调） --- */
QPushButton#btnReset {
    min-width: 56px;
    color: #B91C1C;
    background-color: #FFFFFF;
    border-color: #F3B7B7;
}

QPushButton#btnReset:hover   { background-color: #FFF1F1; border-color: #DC2626; }
QPushButton#btnReset:pressed { background-color: #FEE2E2; border-color: #B91C1C; }

/* --- 选择视频（白底） --- */
QPushButton#btnSelectVideo {
    min-width: 60px;
    background-color: #FFFFFF;
    color: #217346;
}

QPushButton#btnFullscreen {
    min-width: 72px;
    color: #217346;
    background-color: #FFFFFF;
    border-color: #D8DED8;
}

QPushButton#btnFullscreen:checked {
    color: #FFFFFF;
    background-color: #217346;
    border-color: #217346;
}

QPushButton#btnHawkeyeChallenge {
    min-width: 92px;
    color: #1F1F1F;
    background-color: #FACC15;
    border-color: #EAB308;
}

QPushButton#btnHawkeyeChallenge:hover { background-color: #FDE047; border-color: #CA8A04; }
QPushButton#btnHawkeyeChallenge:pressed { background-color: #EAB308; border-color: #A16207; }
QPushButton#btnHawkeyeChallenge:disabled { background-color: #E8EEE8; color: #A19F9D; border-color: #D8DED8; }

/* --- 强制停止（危险色调） --- */
QPushButton#btnForceStop {
    min-width: 76px;
    color: #B91C1C;
    background-color: #FFFFFF;
    border-color: #F3B7B7;
}

QPushButton#btnForceStop:hover   { background-color: #FFF1F1; border-color: #DC2626; }
QPushButton#btnForceStop:pressed { background-color: #FEE2E2; border-color: #B91C1C; }
