.court {
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(16, 35, 29, 0.08);
}

.court:last-child { border-bottom: none; }

.court-head { display: flex; align-items: center; }
.court-main { flex: 1; min-width: 0; padding: 0 18rpx; }

.court-ops {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed rgba(16, 35, 29, 0.1);
}

.op {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.op-label { margin-bottom: 8rpx; font-size: 21rpx; color: #5f7068; }

.price-btn {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(14, 112, 74, 0.1);
  color: #0e704a;
  font-size: 22rpx;
  font-weight: 700;
}

.rule {
  position: relative;
  padding: 10rpx 0 10rpx 26rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #3f4f47;
}

.rule::before {
  content: "";
  position: absolute;
  left: 4rpx;
  top: 22rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #6bc5d2;
}

.sheet-form { margin-top: 22rpx; }

.input {
  margin-top: 10rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(16, 35, 29, 0.05);
  font-size: 27rpx;
}

.picker-view { color: #10231d; }

.switch-row { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 0; }
.switch-main { flex: 1; min-width: 0; padding-right: 20rpx; }
