.date-strip { margin-top: 24rpx; }
.date-scroll { white-space: nowrap; }
.date-strip-inner { display: flex; }

.date-item {
  width: 140rpx;
  flex-shrink: 0;
  margin-right: 14rpx;
  padding: 20rpx 0;
  border-radius: 22rpx;
  text-align: center;
  background: #fffdf7;
  border: 1rpx solid rgba(16, 35, 29, 0.1);
}

.date-item.on {
  background: linear-gradient(135deg, #0e704a, #14855a);
  border-color: transparent;
}

.date-week { font-size: 22rpx; color: #5f7068; }
.date-day { margin-top: 6rpx; font-size: 36rpx; font-weight: 800; }
.date-item.on .date-week { color: rgba(248, 255, 242, 0.8); }
.date-item.on .date-day { color: #f8fff2; }

.chips-scroll { white-space: nowrap; }
.chips .chip { display: inline-block; }

.bk {
  padding: 22rpx 0;
  border-bottom: 1rpx solid rgba(16, 35, 29, 0.08);
}

.bk:last-child { border-bottom: none; }

.bk-head { display: flex; align-items: center; }
.bk-main { flex: 1; min-width: 0; padding: 0 18rpx; }
.bk-right { text-align: right; }

.bk-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.bk-actions .btn { margin-left: 12rpx; }

.bk-note { margin-top: 12rpx; font-size: 22rpx; color: #7d8b83; }

/* 排期表 */
.sched { display: flex; margin-top: 6rpx; }

.sched-time { width: 108rpx; flex-shrink: 0; }

.sched-head {
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #5f7068;
}

.sched-time-cell {
  height: 74rpx;
  line-height: 74rpx;
  text-align: center;
  font-size: 22rpx;
  color: #5f7068;
  border-top: 1rpx solid rgba(16, 35, 29, 0.06);
}

.sched-scroll { flex: 1; white-space: nowrap; }
.sched-courts { display: flex; }

.sched-col { width: 168rpx; flex-shrink: 0; }

.sched-cell {
  height: 74rpx;
  margin: 3rpx 6rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.sched-cell.free { background: rgba(14, 112, 74, 0.10); color: #0b5a3b; }
.sched-cell.busy { background: linear-gradient(135deg, #d4633f, #ee705d); color: #fff5f2; }

.sched-cell-text { padding: 0 4rpx; }

.legend { display: flex; align-items: center; margin-top: 22rpx; }

.legend-item {
  display: flex;
  align-items: center;
  margin-right: 28rpx;
  font-size: 22rpx;
  color: #5f7068;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  margin-right: 10rpx;
  border-radius: 6rpx;
}

.legend-dot.free { background: rgba(14, 112, 74, 0.24); }
.legend-dot.busy { background: #ee705d; }

.rule {
  position: relative;
  padding: 10rpx 0 10rpx 26rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #3f4f47;
}

.rule::before {
  content: "";
  position: absolute;
  left: 4rpx;
  top: 22rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #6bc5d2;
}
