.hero-flex { display: flex; align-items: center; }
.hero-left { flex: 1; min-width: 0; }
.hero-ring { width: 220rpx; height: 220rpx; margin-left: 12rpx; flex-shrink: 0; }

.hero-foot {
  position: relative;
  z-index: 1;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(248, 255, 242, 0.22);
}

.hero-level { font-size: 30rpx; font-weight: 800; }
.hero-note { display: block; margin-top: 6rpx; font-size: 23rpx; color: rgba(248, 255, 242, 0.82); }

.takeaways { display: flex; flex-direction: column; }

.takeaway {
  position: relative;
  margin-top: 12rpx;
  padding: 16rpx 18rpx 16rpx 44rpx;
  border-radius: 20rpx;
  background: rgba(14, 112, 74, 0.08);
  font-size: 25rpx;
  line-height: 1.6;
}

.takeaway::before {
  content: "";
  position: absolute;
  left: 20rpx;
  top: 26rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #0e704a;
}

.dim-list { margin-top: 26rpx; padding-top: 22rpx; border-top: 1rpx solid rgba(16, 35, 29, 0.08); }

.cmp-line { display: flex; align-items: center; margin-top: 10rpx; }
.cmp-tag {
  width: 44rpx;
  flex-shrink: 0;
  font-size: 21rpx;
  font-weight: 700;
  color: #5f7068;
}
.cmp-track { flex: 1; margin-top: 0; }

.court-layout { display: flex; align-items: flex-start; }

.court-box {
  width: 320rpx;
  height: 704rpx;
  flex-shrink: 0;
}

.zone-box { flex: 1; min-width: 0; padding-left: 20rpx; }

.zone-card {
  padding: 16rpx;
  border-radius: 20rpx;
  background: rgba(14, 112, 74, 0.07);
  margin-bottom: 16rpx;
}

.zone-card:last-child { margin-bottom: 0; }

.speed-row { display: flex; margin: 0 -8rpx; }

.speed-cell {
  flex: 1;
  margin: 0 8rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: rgba(14, 112, 74, 0.06);
}

.speed-value { margin-top: 6rpx; font-size: 46rpx; font-weight: 800; color: #0e704a; }

.kv-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 12rpx 0;
}

.kv-row .strong { max-width: 60%; text-align: right; }

.notice {
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(107, 197, 210, 0.16);
  color: #1f6673;
  font-size: 23rpx;
  line-height: 1.6;
}

.improve-card {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(238, 112, 93, 0.12), rgba(240, 190, 73, 0.12));
  border: 1rpx solid rgba(238, 112, 93, 0.18);
}

.improve-card:first-child { margin-top: 0; }

.improve-tip {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.7);
  font-size: 25rpx;
  line-height: 1.6;
}

.plan-card {
  position: relative;
  margin-top: 18rpx;
  padding: 22rpx 22rpx 22rpx 88rpx;
  border-radius: 24rpx;
  background: rgba(14, 112, 74, 0.08);
  border: 1rpx solid rgba(14, 112, 74, 0.14);
}

.plan-card:first-child { margin-top: 0; }

.plan-index {
  position: absolute;
  left: 20rpx;
  top: 22rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f8fff2;
  background: #0e704a;
  font-size: 24rpx;
  font-weight: 800;
}

.capture-item { display: flex; align-items: flex-start; margin-top: 16rpx; }

.capture-dot {
  width: 12rpx;
  height: 12rpx;
  margin: 14rpx 16rpx 0 0;
  border-radius: 50%;
  background: #6bc5d2;
  flex-shrink: 0;
}

.capture-text { flex: 1; font-size: 25rpx; line-height: 1.65; }

.report-actions { display: flex; margin-top: 26rpx; }
.report-actions .btn { flex: 1; margin-right: 16rpx; }
.report-actions .btn:last-child { margin-right: 0; }

.table-head { font-size: 21rpx; }
.table-row { font-size: 24rpx; }

.foot-note {
  margin-top: 20rpx;
  color: #7d8b83;
  font-size: 22rpx;
  line-height: 1.6;
}
