.profile-row { position: relative; z-index: 1; display: flex; align-items: center; }
.profile-main { flex: 1; min-width: 0; margin-left: 24rpx; }
.profile-name { font-size: 40rpx; font-weight: 800; }
.profile-sub { margin-top: 6rpx; font-size: 23rpx; color: rgba(248, 255, 242, 0.78); }

.wallet-row {
  position: relative;
  z-index: 1;
  display: flex;
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(248, 255, 242, 0.22);
}

.wallet-cell { flex: 1; text-align: center; }
.wallet-value { font-size: 36rpx; font-weight: 800; }
.wallet-label { margin-top: 4rpx; font-size: 21rpx; color: rgba(248, 255, 242, 0.74); }

.merchant-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, rgba(14, 112, 74, 0.12), rgba(107, 197, 210, 0.16));
  border-color: rgba(14, 112, 74, 0.18);
}

.merchant-left { flex: 1; min-width: 0; }
.merchant-right { flex-shrink: 0; }

.merchant-btn {
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  color: #f8fff2;
  font-size: 25rpx;
  font-weight: 700;
  background: linear-gradient(120deg, #0e704a, #14855a);
  box-shadow: 0 10rpx 24rpx rgba(14, 112, 74, 0.24);
}

.switch-row { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; }
.switch-main { flex: 1; min-width: 0; padding-right: 20rpx; }

.foot-note {
  margin-top: 26rpx;
  text-align: center;
  color: #7d8b83;
  font-size: 22rpx;
}
