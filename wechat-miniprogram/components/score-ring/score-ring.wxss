.ring {
  position: relative;
  width: 100%;
  height: 100%;
  min-height: 200rpx;
}

.ring-canvas {
  width: 100%;
  height: 100%;
}

.ring-center {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  text-align: center;
  pointer-events: none;
}

.ring-value {
  font-family: "DIN Alternate", "Bahnschrift", -apple-system, sans-serif;
  font-size: 72rpx;
  font-weight: 800;
  line-height: 1;
  color: #10231d;
}

.ring-value.on-dark { color: #f8fff2; }

.ring-max {
  margin-top: 2rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #8d9a93;
}

.ring-max.on-dark { color: rgba(248, 255, 242, 0.7); }

.ring-caption {
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #10231d;
}

.ring-caption.on-dark { color: #b6e95e; }

.ring-sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #8d9a93;
}

.ring-fallback {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 12rpx solid rgba(16, 35, 29, 0.12);
}

.ring-fallback-score { font-size: 60rpx; font-weight: 800; }
