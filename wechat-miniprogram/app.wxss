/* app.wxss —— 全局设计令牌，取自 WFBARNet 报告配色（球场绿 / 柠檬绿 / 金 / 珊瑚 / 天空蓝） */
page {
  --court: #0e704a;
  --court-deep: #073d31;
  --court-soft: rgba(14, 112, 74, 0.08);
  --lime: #b6e95e;
  --gold: #f0be49;
  --coral: #ee705d;
  --sky: #6bc5d2;
  --ink: #10231d;
  --muted: #5f7068;
  --paper: #fffdf7;
  --bg: #f2f6ef;
  --line: rgba(16, 35, 29, 0.10);
  --shadow: 0 16rpx 40rpx rgba(7, 61, 49, 0.10);

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "MiSans", "HarmonyOS Sans SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
}

view, text, scroll-view, button, input, textarea {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
}

.page--tab {
  padding-bottom: 180rpx;
}

.wrap {
  padding: 24rpx 24rpx 40rpx;
}

/* ---------- 文本 ---------- */
.eyebrow {
  color: var(--coral);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.h1 { font-size: 44rpx; font-weight: 800; line-height: 1.25; }
.h2 { font-size: 34rpx; font-weight: 800; }
.h3 { font-size: 30rpx; font-weight: 700; }
.muted { color: var(--muted); }
.small { font-size: 24rpx; }
.tiny { font-size: 22rpx; }
.strong { font-weight: 700; }
.num { font-family: "DIN Alternate", "Bahnschrift", -apple-system, sans-serif; }

/* ---------- 卡片 ---------- */
.card {
  margin-top: 20rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  background: var(--paper);
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow);
}

.card--flat { box-shadow: none; }

.card-hd {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-title { font-size: 32rpx; font-weight: 800; }

.card-sub {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 23rpx;
}

.card-more {
  color: var(--court);
  font-size: 24rpx;
  font-weight: 700;
}

/* ---------- 顶部 Hero ---------- */
.hero {
  position: relative;
  overflow: hidden;
  padding: 34rpx 30rpx;
  border-radius: 32rpx;
  color: #f8fff2;
  background: linear-gradient(135deg, #073d31 0%, #0e704a 58%, #c9a02f 130%);
  box-shadow: 0 20rpx 48rpx rgba(7, 61, 49, 0.28);
}

.hero::after {
  content: "";
  position: absolute;
  right: -120rpx;
  bottom: -160rpx;
  width: 420rpx;
  height: 420rpx;
  border-radius: 50%;
  background: repeating-linear-gradient(35deg, rgba(255, 255, 255, 0.16) 0 2rpx, rgba(255, 255, 255, 0) 2rpx 20rpx);
}

.hero-inner { position: relative; z-index: 1; }

.hero .eyebrow { color: var(--lime); }

.hero-title {
  margin-top: 8rpx;
  font-size: 42rpx;
  font-weight: 800;
}

.hero-sub {
  margin-top: 10rpx;
  color: rgba(248, 255, 242, 0.84);
  font-size: 24rpx;
}

.hero-pills {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.hero-pill {
  margin: 8rpx 10rpx 0 0;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(248, 255, 242, 0.26);
  background: rgba(255, 255, 255, 0.10);
  font-size: 22rpx;
  color: rgba(248, 255, 242, 0.94);
}

/* ---------- 指标格 ---------- */
.metric-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.metric {
  width: calc(50% - 16rpx);
  margin: 8rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: var(--paper);
  border: 1rpx solid var(--line);
}

.metric--half {
  width: calc(50% - 16rpx);
}

.metric-label { color: var(--muted); font-size: 23rpx; }
.metric-value { margin-top: 8rpx; font-size: 40rpx; font-weight: 800; line-height: 1.1; }
.metric-hint { margin-top: 8rpx; color: #7d8b83; font-size: 21rpx; line-height: 1.45; }

/* ---------- 行 / 进度条 ---------- */
.row { margin-top: 22rpx; }
.row:first-child { margin-top: 0; }

.row-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.row-name { font-size: 27rpx; font-weight: 700; }
.row-value { font-size: 27rpx; font-weight: 700; }
.row-note { margin-top: 8rpx; color: var(--muted); font-size: 22rpx; line-height: 1.5; }

.bar-track {
  margin-top: 12rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: rgba(16, 35, 29, 0.09);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #0e704a, #b6e95e);
}

.bar-fill--gold { background: linear-gradient(90deg, #ee705d, #f0be49); }
.bar-fill--sky { background: linear-gradient(90deg, #2f9fb0, #6bc5d2); }
.bar-fill--mute { background: linear-gradient(90deg, #8fa39a, #c7d4cd); }

.bar-mini { width: 150rpx; }

/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  margin: 8rpx 10rpx 0 0;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(16, 35, 29, 0.07);
  color: var(--ink);
  font-size: 21rpx;
  font-weight: 700;
}

.tag--gold { background: rgba(240, 190, 73, 0.22); color: #7d5a12; }
.tag--coral { background: rgba(238, 112, 93, 0.18); color: #8d382b; }
.tag--sky { background: rgba(107, 197, 210, 0.22); color: #1f6673; }
.tag--court { background: rgba(14, 112, 74, 0.12); color: #0b5a3b; }

.badge {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
  background: rgba(16, 35, 29, 0.08);
  color: var(--muted);
}

.badge--ok { background: rgba(14, 112, 74, 0.14); color: #0b5a3b; }
.badge--warn { background: rgba(240, 190, 73, 0.24); color: #7d5a12; }
.badge--danger { background: rgba(238, 112, 93, 0.18); color: #8d382b; }
.badge--info { background: rgba(107, 197, 210, 0.22); color: #1f6673; }

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin: 0;
  padding: 0 34rpx;
  border-radius: 999rpx;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1;
  border: 1rpx solid var(--line);
  background: #ffffff;
  color: var(--ink);
}

.btn::after { border: none; }

.btn--primary {
  color: #f8fff2;
  border-color: transparent;
  background: linear-gradient(120deg, #0e704a, #14855a);
  box-shadow: 0 12rpx 28rpx rgba(14, 112, 74, 0.26);
}

.btn--ghost { background: rgba(14, 112, 74, 0.08); color: var(--court); border-color: rgba(14, 112, 74, 0.16); }
.btn--danger { background: rgba(238, 112, 93, 0.12); color: #8d382b; border-color: rgba(238, 112, 93, 0.22); }
.btn--block { width: 100%; }
.btn--sm { height: 66rpx; padding: 0 24rpx; font-size: 25rpx; }

.btn-row {
  display: flex;
  margin-top: 20rpx;
}

.btn-row .btn { flex: 1; margin-right: 16rpx; }
.btn-row .btn:last-child { margin-right: 0; }

/* ---------- 分段控件 ---------- */
.seg {
  display: flex;
  padding: 6rpx;
  border-radius: 999rpx;
  background: rgba(16, 35, 29, 0.07);
}

.seg-item {
  flex: 1;
  padding: 14rpx 0;
  border-radius: 999rpx;
  text-align: center;
  color: var(--muted);
  font-size: 25rpx;
  font-weight: 700;
}

.seg-item.on {
  color: var(--court);
  background: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(7, 61, 49, 0.10);
}

/* ---------- chips ---------- */
.chips {
  white-space: nowrap;
  margin-top: 20rpx;
}

.chip {
  display: inline-block;
  margin-right: 14rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  background: #ffffff;
  color: var(--muted);
  font-size: 25rpx;
}

.chip.on {
  color: #f8fff2;
  border-color: transparent;
  background: linear-gradient(120deg, #0e704a, #14855a);
  font-weight: 700;
}

/* ---------- 列表 ---------- */
.list { margin-top: 4rpx; }

.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.list-item:last-child { border-bottom: none; }

.li-main { flex: 1; min-width: 0; }
.li-title { font-size: 29rpx; font-weight: 700; }
.li-sub { margin-top: 6rpx; color: var(--muted); font-size: 23rpx; }
.li-right { margin-left: 16rpx; text-align: right; }
.li-arrow {
  width: 16rpx;
  height: 16rpx;
  margin-left: 14rpx;
  border-top: 3rpx solid #b3c0b9;
  border-right: 3rpx solid #b3c0b9;
  transform: rotate(45deg);
}

.divider { height: 1rpx; background: var(--line); margin: 22rpx 0; }

/* ---------- 空态 ---------- */
.empty {
  padding: 70rpx 20rpx;
  text-align: center;
  color: var(--muted);
  font-size: 25rpx;
}

.empty-badge {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  border: 4rpx dashed rgba(14, 112, 74, 0.28);
  background: rgba(14, 112, 74, 0.05);
}

/* ---------- 头像 ---------- */
.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f8fff2;
  font-size: 38rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #0e704a, #6bc5d2);
}

/* ---------- 底部操作条 ---------- */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 253, 247, 0.96);
  border-top: 1rpx solid var(--line);
  box-shadow: 0 -10rpx 30rpx rgba(7, 61, 49, 0.08);
}

/* ---------- 遮罩 / 底部弹层 ---------- */
.mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: rgba(7, 20, 16, 0.45);
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  max-height: 80vh;
  padding: 30rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx 34rpx 0 0;
  background: var(--paper);
}

.sheet-title { font-size: 33rpx; font-weight: 800; }

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(16, 35, 29, 0.07);
  color: var(--muted);
  text-align: center;
  line-height: 56rpx;
  font-size: 28rpx;
}

/* ---------- 表格 ---------- */
.table-head,
.table-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 25rpx;
}

.table-head { color: var(--muted); font-size: 22rpx; }
.table-row:last-child { border-bottom: none; }
.col-time { width: 150rpx; }
.col-flex { flex: 1; }
.col-right { width: 140rpx; text-align: right; }

/* ---------- 滚动条 ---------- */
.scroll-x { overflow: hidden; }

/* ---------- 入场动画 ---------- */
@keyframes rise {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.rise { animation: rise 380ms ease both; }
.rise-1 { animation: rise 380ms ease 60ms both; }
.rise-2 { animation: rise 380ms ease 120ms both; }
.rise-3 { animation: rise 380ms ease 180ms both; }

/* ---------- 商家端 ---------- */
.m-nav {
  display: flex;
  padding: 8rpx 24rpx 0;
  background: var(--paper);
  border-bottom: 1rpx solid var(--line);
}

.m-nav-item {
  flex: 1;
  padding: 20rpx 0;
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
  border-bottom: 5rpx solid transparent;
}

.m-nav-item.on {
  color: var(--court);
  font-weight: 800;
  border-bottom-color: var(--court);
}

.court-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 56rpx;
  height: 56rpx;
  padding: 0 12rpx;
  border-radius: 16rpx;
  color: #f8fff2;
  font-size: 24rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #0e704a, #17764f);
}

.court-badge--idle { background: rgba(16, 35, 29, 0.10); color: var(--muted); }
.court-badge--busy { background: linear-gradient(135deg, #d4633f, #ee705d); }
.court-badge--off { background: linear-gradient(135deg, #8d9993, #a9b4ae); }
